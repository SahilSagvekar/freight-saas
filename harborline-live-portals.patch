@@ -0,0 +1,11 @@
+import { headers } from "next/headers";
+
+/** The public address of this app, for links we hand to people. APP_URL wins; otherwise it is read from the request. */
+export async function appBaseUrl(): Promise<string> {
+  const configured = process.env.APP_URL?.trim();
+  if (configured) return configured.replace(/\/+$/, "");
+  const h = await headers();
+  const host = h.get("x-forwarded-host") ?? h.get("host") ?? "localhost:3000";
+  const proto = h.get("x-forwarded-proto") ?? (host.startsWith("localhost") ? "http" : "https");
+  return `${proto}://${host}`;
+}
diff --git a/src/server/team-actions.ts b/src/server/team-actions.ts
new file mode 100644
index 0000000..07ca07b
--- /dev/null
+++ b/src/server/team-actions.ts
@@ -0,0 +1,79 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { z } from "zod";
+import { PERMISSIONS } from "@/lib/domain";
+import { requirePermission } from "./auth";
+import type { ActionResult } from "./booking-actions";
+import { appBaseUrl } from "./base-url";
+import { BookingError } from "./bookings";
+import { issueSetupLink } from "./setup-links";
+import { addMember, changeMemberRole, createRole, deleteRole, memberForReset, setMemberActive, updateRolePermissions } from "./team";
+
+async function guarded<T>(fn: (a: { tenantId: string; actorId: string }) => Promise<T>): Promise<ActionResult<T>> {
+  const auth = await requirePermission("team.manage");
+  try {
+    const data = await fn({ tenantId: auth.tenantId, actorId: auth.userId });
+    revalidatePath("/app/team");
+    return { ok: true, data };
+  } catch (e) {
+    if (e instanceof BookingError) return { ok: false, error: e.message, fields: e.fields };
+    console.error(e);
+    return { ok: false, error: "Something went wrong. Please try again." };
+  }
+}
+
+const first = (r: { error: z.ZodError }) => r.error.issues[0]?.message ?? "Check the form and try again.";
+const uuid = z.string().uuid("Pick a role");
+const permissionList = (f: FormData) => f.getAll("permissions").map(String).filter((p) => p in PERMISSIONS);
+
+export type InviteResult = { link: string; name: string; email: string };
+
+/** Adds a person and returns a one-time link for them to choose a password. Shown once; it is not stored. */
+export async function addMemberAction(f: FormData): Promise<ActionResult<InviteResult>> {
+  const p = z
+    .object({ name: z.string().trim().min(1, "Enter their name").max(80), email: z.string().trim().email("Enter a valid email").max(200), roleId: uuid })
+    .safeParse({ name: f.get("name"), email: f.get("email"), roleId: f.get("roleId") });
+  if (!p.success) return { ok: false, error: first(p) };
+  const base = await appBaseUrl();
+  return guarded(async (a) => {
+    const { userId } = await addMember(a, p.data);
+    return { link: await issueSetupLink(userId, base), name: p.data.name, email: p.data.email.toLowerCase() };
+  });
+}
+
+/** A fresh link for someone who forgot their password or never used the first one. Their current password keeps working until they use it. */
+export async function resetLinkAction(membershipId: string): Promise<ActionResult<InviteResult>> {
+  if (!uuid.safeParse(membershipId).success) return { ok: false, error: "Unknown person." };
+  const base = await appBaseUrl();
+  return guarded(async (a) => {
+    const who = await memberForReset(a, membershipId);
+    return { link: await issueSetupLink(who.userId, base), name: who.name, email: who.email };
+  });
+}
+
+export async function changeRoleAction(membershipId: string, roleId: string): Promise<ActionResult> {
+  if (!uuid.safeParse(membershipId).success || !uuid.safeParse(roleId).success) return { ok: false, error: "Unknown person or role." };
+  return guarded((a) => changeMemberRole(a, membershipId, roleId));
+}
+
+export async function setActiveAction(membershipId: string, active: boolean): Promise<ActionResult> {
+  if (!uuid.safeParse(membershipId).success) return { ok: false, error: "Unknown person." };
+  return guarded((a) => setMemberActive(a, membershipId, active));
+}
+
+export async function createRoleAction(f: FormData): Promise<ActionResult> {
+  const p = z.object({ name: z.string().trim().min(2, "Give the role a name").max(40) }).safeParse({ name: f.get("name") });
+  if (!p.success) return { ok: false, error: first(p) };
+  return guarded((a) => createRole(a, { name: p.data.name, permissions: permissionList(f) }));
+}
+
+export async function updateRoleAction(roleId: string, f: FormData): Promise<ActionResult> {
+  if (!uuid.safeParse(roleId).success) return { ok: false, error: "Unknown role." };
+  return guarded((a) => updateRolePermissions(a, roleId, permissionList(f)));
+}
+
+export async function deleteRoleAction(roleId: string): Promise<ActionResult> {
+  if (!uuid.safeParse(roleId).success) return { ok: false, error: "Unknown role." };
+  return guarded((a) => deleteRole(a, roleId));
+}
diff --git a/src/server/team.ts b/src/server/team.ts
new file mode 100644
index 0000000..addb3a4
--- /dev/null
+++ b/src/server/team.ts
@@ -0,0 +1,150 @@
+import { randomBytes } from "node:crypto";
+import { adminTransaction, withTenant, type Tx } from "@/db";
+import { ALL_PERMISSIONS, type Permission } from "@/lib/domain";
+import { hashPassword } from "@/lib/password";
+import { BookingError } from "./bookings";
+import { audit } from "./shared";
+
+/**
+ * Team changes run on the admin connection because the app role may not write users. That connection skips
+ * row-level security, so every query below names the tenant explicitly and never trusts an id on its own.
+ */
+type Actor = { tenantId: string; actorId: string };
+
+export type TeamMember = { membershipId: string; userId: string; name: string; email: string; roleId: string; roleName: string; status: string; createdAt: Date };
+export type RoleRow = { id: string; name: string; permissions: Permission[]; isSystem: boolean; members: number };
+
+export async function listTeam(tenantId: string): Promise<{ members: TeamMember[]; roles: RoleRow[] }> {
+  return withTenant(tenantId, async (tx) => {
+    const [memberships, roles] = await Promise.all([
+      tx.membership.findMany({
+        include: { user: { select: { id: true, name: true, email: true } }, role: { select: { id: true, name: true } } },
+        orderBy: { createdAt: "asc" },
+      }),
+      tx.role.findMany({ orderBy: [{ isSystem: "desc" }, { createdAt: "asc" }] }),
+    ]);
+    const counts = new Map<string, number>();
+    for (const m of memberships) if (m.status === "active") counts.set(m.roleId, (counts.get(m.roleId) ?? 0) + 1);
+    return {
+      members: memberships.map((m) => ({
+        membershipId: m.id,
+        userId: m.user.id,
+        name: m.user.name,
+        email: m.user.email,
+        roleId: m.role.id,
+        roleName: m.role.name,
+        status: m.status,
+        createdAt: m.createdAt,
+      })),
+      roles: roles.map((r) => ({ id: r.id, name: r.name, permissions: r.permissions as Permission[], isSystem: r.isSystem, members: counts.get(r.id) ?? 0 })),
+    };
+  });
+}
+
+/** Throws (and so rolls the whole change back) if nobody active could manage the team any more. */
+async function assertSomeoneCanManageTeam(tx: Tx, tenantId: string) {
+  const rows = await tx.$queryRaw<{ n: bigint }[]>`
+    select count(*) as n from memberships m join roles r on r.id = m.role_id
+    where m.tenant_id = ${tenantId}::uuid and m.status = 'active' and 'team.manage' = any(r.permissions)`;
+  if (Number(rows[0]?.n ?? 0) < 1) {
+    throw new BookingError("INVALID", "That would leave nobody able to manage the team. Make someone else an owner first.");
+  }
+}
+
+async function ownMembership(tx: Tx, tenantId: string, membershipId: string) {
+  const m = await tx.membership.findFirst({ where: { id: membershipId, tenantId }, include: { user: { select: { id: true, name: true, email: true } } } });
+  if (!m) throw new BookingError("NOT_FOUND", "That person isn't on your team.");
+  return m;
+}
+
+async function ownRole(tx: Tx, tenantId: string, roleId: string) {
+  const r = await tx.role.findFirst({ where: { id: roleId, tenantId } });
+  if (!r) throw new BookingError("NOT_FOUND", "That role doesn't exist.");
+  return r;
+}
+
+export async function addMember(a: Actor, input: { name: string; email: string; roleId: string }): Promise<{ membershipId: string; userId: string }> {
+  const email = input.email.trim().toLowerCase();
+  const unusable = await hashPassword(randomBytes(32).toString("base64url"));
+  return adminTransaction(async (tx) => {
+    await ownRole(tx, a.tenantId, input.roleId);
+    const existing = await tx.$queryRaw<{ id: string }[]>`select id from users where lower(email) = ${email}`;
+    if (existing.length > 0) {
+      // Attaching someone who already has an account would let any owner probe which emails exist. Refused on purpose.
+      throw new BookingError("INVALID", "That email already has an account. Ask them to use a different email for this team.", { email: "Already in use" });
+    }
+    const user = await tx.user.create({ data: { name: input.name.trim(), email, passwordHash: unusable } });
+    const m = await tx.membership.create({ data: { tenantId: a.tenantId, userId: user.id, roleId: input.roleId } });
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "team.add", entity: "membership", entityId: m.id, after: { email, roleId: input.roleId } });
+    return { membershipId: m.id, userId: user.id };
+  });
+}
+
+export async function changeMemberRole(a: Actor, membershipId: string, roleId: string) {
+  await adminTransaction(async (tx) => {
+    const m = await ownMembership(tx, a.tenantId, membershipId);
+    await ownRole(tx, a.tenantId, roleId);
+    if (m.roleId === roleId) return;
+    await tx.membership.update({ where: { id: m.id }, data: { roleId } });
+    await assertSomeoneCanManageTeam(tx, a.tenantId);
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "team.role", entity: "membership", entityId: m.id, before: { roleId: m.roleId }, after: { roleId } });
+  });
+}
+
+export async function setMemberActive(a: Actor, membershipId: string, active: boolean) {
+  await adminTransaction(async (tx) => {
+    const m = await ownMembership(tx, a.tenantId, membershipId);
+    if (!active && m.userId === a.actorId) throw new BookingError("INVALID", "You can't deactivate yourself.");
+    const status = active ? "active" : "disabled";
+    if (m.status === status) return;
+    await tx.membership.update({ where: { id: m.id }, data: { status } });
+    await assertSomeoneCanManageTeam(tx, a.tenantId);
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: active ? "team.activate" : "team.deactivate", entity: "membership", entityId: m.id, before: { status: m.status }, after: { status } });
+  });
+}
+
+/** Confirms the membership is on this team and returns who it is, for issuing a reset link. */
+export async function memberForReset(a: Actor, membershipId: string) {
+  return adminTransaction(async (tx) => {
+    const m = await ownMembership(tx, a.tenantId, membershipId);
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "team.reset-link", entity: "membership", entityId: m.id });
+    return { userId: m.user.id, name: m.user.name, email: m.user.email };
+  });
+}
+
+function cleanPermissions(input: string[]): Permission[] {
+  const wanted = new Set(input);
+  return ALL_PERMISSIONS.filter((p) => wanted.has(p));
+}
+
+export async function createRole(a: Actor, input: { name: string; permissions: string[] }) {
+  const name = input.name.trim();
+  await adminTransaction(async (tx) => {
+    const clash = await tx.role.findFirst({ where: { tenantId: a.tenantId, name: { equals: name, mode: "insensitive" } } });
+    if (clash) throw new BookingError("INVALID", "A role with that name already exists.");
+    const role = await tx.role.create({ data: { tenantId: a.tenantId, name, permissions: cleanPermissions(input.permissions) } });
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "role.create", entity: "role", entityId: role.id, after: { name, permissions: role.permissions } });
+  });
+}
+
+export async function updateRolePermissions(a: Actor, roleId: string, permissions: string[]) {
+  await adminTransaction(async (tx) => {
+    const role = await ownRole(tx, a.tenantId, roleId);
+    if (role.isSystem) throw new BookingError("INVALID", "The Owner role always has every permission.");
+    const next = cleanPermissions(permissions);
+    await tx.role.update({ where: { id: role.id }, data: { permissions: next } });
+    await assertSomeoneCanManageTeam(tx, a.tenantId);
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "role.update", entity: "role", entityId: role.id, before: { permissions: role.permissions }, after: { permissions: next } });
+  });
+}
+
+export async function deleteRole(a: Actor, roleId: string) {
+  await adminTransaction(async (tx) => {
+    const role = await ownRole(tx, a.tenantId, roleId);
+    if (role.isSystem) throw new BookingError("INVALID", "The Owner role can't be deleted.");
+    const inUse = await tx.membership.count({ where: { tenantId: a.tenantId, roleId } });
+    if (inUse > 0) throw new BookingError("INVALID", "Move everyone off this role before deleting it.");
+    await tx.role.delete({ where: { id: role.id } });
+    await audit(tx, { tenantId: a.tenantId, actorId: a.actorId, action: "role.delete", entity: "role", entityId: role.id, before: { name: role.name } });
+  });
+}
diff --git a/tests/team.test.ts b/tests/team.test.ts
new file mode 100644
index 0000000..c379e3d
--- /dev/null
+++ b/tests/team.test.ts
@@ -0,0 +1,95 @@
+import { afterAll, describe, expect, it } from "vitest";
+import { adminDb, closeDb } from "@/db";
+import { authenticate } from "@/server/credentials";
+import { applySetupToken, issueSetupLink } from "@/server/setup-links";
+import { addMember, changeMemberRole, createRole, deleteRole, listTeam, setMemberActive, updateRolePermissions } from "@/server/team";
+import { makeTenant } from "./helpers";
+
+afterAll(closeDb);
+
+const actor = (t: { tenantId: string; ownerUserId: string }) => ({ tenantId: t.tenantId, actorId: t.ownerUserId });
+const roleId = async (tenantId: string, name: string) => (await adminDb().role.findFirstOrThrow({ where: { tenantId, name } })).id;
+
+describe("team", () => {
+  it("adds a person who can only sign in after choosing a password from their link", async () => {
+    const t = await makeTenant("Team");
+    const { userId } = await addMember(actor(t), { name: "Dana Dock", email: "Dana@Example.test", roleId: await roleId(t.tenantId, "Dock crew") });
+    expect(await authenticate("dana@example.test", "anything-at-all-1")).toBeNull();
+
+    const token = new URL(await issueSetupLink(userId, "https://x.test")).searchParams.get("token")!;
+    expect(await applySetupToken(token, "dana-picked-this-one")).toMatchObject({ ok: true });
+    expect(await authenticate("dana@example.test", "dana-picked-this-one")).toMatchObject({ uid: userId, tid: t.tenantId });
+  });
+
+  it("refuses an email that already has an account, in this or any other operator", async () => {
+    const a = await makeTenant("Team");
+    const b = await makeTenant("Team");
+    await expect(addMember(actor(a), { name: "Copy", email: b.email, roleId: await roleId(a.tenantId, "Cashier") })).rejects.toThrow(/already has an account/);
+  });
+
+  it("will not use a role that belongs to another operator", async () => {
+    const a = await makeTenant("Team");
+    const b = await makeTenant("Team");
+    await expect(addMember(actor(a), { name: "X", email: "x@example.test", roleId: await roleId(b.tenantId, "Owner") })).rejects.toThrow(/doesn't exist/);
+  });
+
+  it("cannot touch another operator's people", async () => {
+    const a = await makeTenant("Team");
+    const b = await makeTenant("Team");
+    const theirs = (await listTeam(b.tenantId)).members[0]!;
+    await expect(setMemberActive(actor(a), theirs.membershipId, false)).rejects.toThrow(/isn't on your team/);
+    await expect(changeMemberRole(actor(a), theirs.membershipId, await roleId(a.tenantId, "Cashier"))).rejects.toThrow(/isn't on your team/);
+  });
+
+  it("always leaves someone able to manage the team", async () => {
+    const t = await makeTenant("Team");
+    const owner = (await listTeam(t.tenantId)).members[0]!;
+    const manager = await roleId(t.tenantId, "Manager");
+
+    await expect(changeMemberRole(actor(t), owner.membershipId, manager)).rejects.toThrow(/nobody able to manage/);
+    await expect(setMemberActive({ tenantId: t.tenantId, actorId: "someone-else" }, owner.membershipId, false)).rejects.toThrow(/nobody able to manage/);
+    // Rolled back: the owner is unchanged.
+    expect((await listTeam(t.tenantId)).members[0]).toMatchObject({ roleName: "Owner", status: "active" });
+  });
+
+  it("does not let you deactivate yourself", async () => {
+    const t = await makeTenant("Team");
+    const me = (await listTeam(t.tenantId)).members[0]!;
+    await expect(setMemberActive(actor(t), me.membershipId, false)).rejects.toThrow(/deactivate yourself/);
+  });
+
+  it("deactivated people cannot sign in, and can be brought back", async () => {
+    const t = await makeTenant("Team");
+    const { userId, membershipId } = await addMember(actor(t), { name: "Sam", email: "sam@example.test", roleId: await roleId(t.tenantId, "Cashier") });
+    const token = new URL(await issueSetupLink(userId, "https://x.test")).searchParams.get("token")!;
+    await applySetupToken(token, "sam-has-a-password");
+    await setMemberActive(actor(t), membershipId, false);
+    expect(await authenticate("sam@example.test", "sam-has-a-password")).toBeNull();
+    await setMemberActive(actor(t), membershipId, true);
+    expect(await authenticate("sam@example.test", "sam-has-a-password")).not.toBeNull();
+  });
+
+  it("creates, edits and deletes custom roles, but not the Owner role", async () => {
+    const t = await makeTenant("Team");
+    await createRole(actor(t), { name: "Gate supervisor", permissions: ["booking.view", "manifest.update", "not-a-permission"] });
+    await expect(createRole(actor(t), { name: "gate SUPERVISOR", permissions: [] })).rejects.toThrow(/already exists/);
+
+    const { roles } = await listTeam(t.tenantId);
+    const gate = roles.find((r) => r.name === "Gate supervisor")!;
+    expect(gate.permissions).toEqual(["booking.view", "manifest.update"]);
+
+    await updateRolePermissions(actor(t), gate.id, ["booking.view"]);
+    expect((await listTeam(t.tenantId)).roles.find((r) => r.id === gate.id)!.permissions).toEqual(["booking.view"]);
+
+    await expect(updateRolePermissions(actor(t), roles.find((r) => r.name === "Owner")!.id, [])).rejects.toThrow(/always has every permission/);
+    await deleteRole(actor(t), gate.id);
+    await expect(deleteRole(actor(t), roles.find((r) => r.name === "Owner")!.id)).rejects.toThrow(/can't be deleted/);
+  });
+
+  it("will not delete a role that people still hold", async () => {
+    const t = await makeTenant("Team");
+    const cashier = await roleId(t.tenantId, "Cashier");
+    await addMember(actor(t), { name: "Sam", email: "sam2@example.test", roleId: cashier });
+    await expect(deleteRole(actor(t), cashier)).rejects.toThrow(/Move everyone off/);
+  });
+});
