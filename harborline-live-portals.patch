+  }
+
+  return (
+    <AuthShell title={`Welcome, ${who.name.split(" ")[0]}`} subtitle="Choose the password you will use to sign in.">
+      <SetPasswordForm token={value} email={who.email} />
+    </AuthShell>
+  );
+}
