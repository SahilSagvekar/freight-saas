# Copy to .env.local for development, or set these in your host's environment for production.
# Never commit real values.

# The app connects as a role that CANNOT bypass row-level security (see src/db/migrate.ts for its grants).
DATABASE_URL=postgres://freight_app:CHANGE_ME@your-db-host:5432/freight

# The table owner. Used for sign-in lookups, creating operators and running migrations.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@your-db-host:5432/freight

# At least 32 random characters, for example: openssl rand -base64 48
# The app refuses to start in production without it. Setup links are signed with the same value.
SESSION_SECRET=

# The public address of the live site. Used in one-time links printed by `npm run tenant:create`
# and shown to owners when they add a team member.
APP_URL=https://app.example.com

# Only for a hosted DEMO database, never for live data. The demo seed refuses to run without it
# on a non-local database, and refuses any database that holds a real operator.
# ALLOW_DEMO_SEED=this-is-the-demo-database

# Email over SMTP (Gmail, Zoho, Brevo, your own domain's host, ...). SMTP_HOST and MAIL_FROM turn it on;
# without them nothing is sent and links are shown on screen instead.
# Test with: npm run mail:test -- --to you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Only needed to override: "true" for implicit TLS (default on port 465), "false" for STARTTLS (587).
# SMTP_SECURE=
# Usually the same address as SMTP_USER, for example: Harborline <you@gmail.com>
MAIL_FROM=

# Sign-ups are limited per address and per email in production so bots can't use you to send email.
# Set to "off" to remove that limit (only for a private demo or pilot).
# SIGNUP_THROTTLE=off
